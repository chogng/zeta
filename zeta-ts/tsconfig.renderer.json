    "src/zeta/platform/native/common/**/*.ts",
    "src/zeta/platform/native/electron-browser/**/*.ts",
    "src/zeta/platform/search/**/*.ts",
    "src/zeta/platform/browser/common/**/*.ts",
    "src/zeta/platform/theme/browser/**/*.ts",
    "src/zeta/platform/theme/common/**/*.ts",
    "src/zeta/platform/workspace/common/**/*.ts",
    "src/zeta/platform/webview/browser/**/*.ts",
    "src/zeta/workbench/**/*.ts",
    "generated/**/*.ts"
  ],
  "exclude": [
    "src/zeta/base/test/**/*.ts",
    "src/zeta/base/parts/**/electron-main/**/*.ts",
    "src/zeta/editor/*/test/**/*.ts",
    "src/zeta/platform/keybinding/electron-main/**/*.ts"
