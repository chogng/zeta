{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client", "@webgpu/types"]
  },
  "include": [
    "src/typings/**/*.d.ts",
    "src/zeta/base/**/*.ts",
    "src/zeta/code/browser/**/*.ts",
    "src/zeta/code/electron-browser/workbench/**/*.ts",
    "src/zeta/editor/*/browser/**/*.ts",
    "src/zeta/editor/*/common/**/*.ts",
    "src/zeta/editor/*/contrib/**/*.ts",
    "src/zeta/editor/*/*.ts",
    "src/zeta/platform/app-server/common/**/*.ts",
    "src/zeta/platform/app-server/browser/**/*.ts",
    "src/zeta/platform/action/common/**/*.ts",
    "src/zeta/platform/actions/**/*.ts",
    "src/zeta/platform/commands/common/**/*.ts",
    "src/zeta/platform/configuration/common/**/*.ts",
    "src/zeta/platform/contextkey/common/**/*.ts",
    "src/zeta/platform/contextview/browser/**/*.ts",
    "src/zeta/platform/contextview/electron-browser/**/*.ts",
    "src/zeta/platform/editor/**/*.ts",
    "src/zeta/platform/instantiation/common/**/*.ts",
    "src/zeta/platform/keybinding/**/*.ts",
    "src/zeta/platform/keyboardLayout/**/*.ts",
    "src/zeta/platform/list/**/*.ts",
    "src/zeta/platform/menubar/common/**/*.ts",
