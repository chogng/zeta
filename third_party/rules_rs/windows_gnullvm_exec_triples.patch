--- a/rs/private/cargo_repository.bzl
+++ b/rs/private/cargo_repository.bzl
@@ -5,4 +5,10 @@
 def _cargo_repository_impl(rctx):
     exec_triple = triple(rctx.attr.triple)
     download_and_extract(rctx, "cargo", "cargo", exec_triple)
+    # The gnullvm Cargo binary dynamically loads libunwind.dll from the Rust
+    # toolchain bin directory. rules_rs normally splits Cargo and rustc into
+    # separate repositories, so merge the matching rustc component into the
+    # Cargo repository to reproduce rustup's executable layout.
+    if exec_triple.system == "windows" and exec_triple.abi == "gnullvm":
+        download_and_extract(rctx, "rustc", "rustc", exec_triple, sha256 = rctx.attr.rustc_sha256)
     rctx.file("BUILD.bazel", BUILD_for_cargo(exec_triple))
@@ -12,4 +18,7 @@
+_CARGO_REPOSITORY_ATTRS = dict(RUST_REPOSITORY_COMMON_ATTR)
+_CARGO_REPOSITORY_ATTRS["rustc_sha256"] = attr.string()
+
 cargo_repository = repository_rule(
     implementation = _cargo_repository_impl,
-    attrs = RUST_REPOSITORY_COMMON_ATTR,
+    attrs = _CARGO_REPOSITORY_ATTRS,
 )
