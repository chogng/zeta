{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Run Zeta Code",
			"type": "node-terminal",
			"request": "launch",
			"command": "just zeta-dev",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "zeta-code",
				"order": 1
			}
		},
		{
			"name": "Run app (watch)",
			"type": "node-terminal",
			"request": "launch",
			"command": "just app-dev",
			"cwd": "${workspaceFolder}",
			"presentation": {
				"group": "app",
				"order": 1
			}
		},
		{
			"name": "Stanza Editor - Standalone",
			"type": "chrome",
			"request": "launch",
			"url": "http://127.0.0.1:5199/build/vite/stanza/index.html",
			"webRoot": "${workspaceFolder}",
			"preLaunchTask": "Launch Stanza Vite",
			"presentation": {
				"group": "stanza",
				"order": 1
			}
		}
	]
}
