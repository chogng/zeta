{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Launch Stanza Vite",
			"type": "shell",
			"command": "corepack pnpm run dev:stanza",
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"fileLocation": "absolute",
				"pattern": {
					"regexp": "^(.+?):(\\d+):(\\d+):\\s+(error|warning)\\s+(.*)$",
					"file": 1,
					"line": 2,
					"column": 3,
					"severity": 4,
					"message": 5
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*VITE.*",
					"endsPattern": "(Local|Network):.*"
				}
			}
		}
	]
}
