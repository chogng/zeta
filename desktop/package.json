{
  "name": "zeta-desktop",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron"
    ]
  },
  "version": "0.1.0",
  "description": "Electron client for the Zeta app-server protocol",
  "main": "dist/main/src/main.js",
  "scripts": {
    "icons:sync": "node scripts/sync-product-icons.mjs",
    "icons:check": "node scripts/sync-product-icons.mjs --check",
    "tokens:generate": "node scripts/compile-design-tokens.mjs",
    "tokens:check": "node scripts/compile-design-tokens.mjs --check",
    "prebuild": "node scripts/sync-generated-resources.mjs",
    "prebuild:host": "node scripts/sync-generated-resources.mjs",
    "prebuild:main": "node scripts/sync-generated-resources.mjs",
    "prebuild:preload": "node scripts/sync-generated-resources.mjs",
    "prebuild:renderer": "node scripts/sync-generated-resources.mjs",
    "predev": "node scripts/sync-generated-resources.mjs && node scripts/prepare-dev-package.mjs",
    "predev:ui": "node scripts/sync-generated-resources.mjs",
    "predev:electron": "node scripts/prepare-dev-package.mjs",
    "predev:main": "node scripts/sync-generated-resources.mjs",
    "predev:preload": "node scripts/sync-generated-resources.mjs",
    "predev:renderer": "node scripts/sync-generated-resources.mjs",
    "predev:web": "node scripts/sync-generated-resources.mjs",
    "predev:web:full": "node scripts/sync-generated-resources.mjs && node scripts/prepare-dev-package.mjs",
    "pretest:main": "node scripts/sync-generated-resources.mjs",
    "pretypecheck:renderer": "node scripts/sync-generated-resources.mjs",
    "build": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/verify-sandbox-preload.mjs && tsc -p tsconfig.renderer.json --noEmit && vite build",
    "build:code": "cross-env ZETA_PRODUCT=code pnpm run build",
    "build:academic": "cross-env ZETA_PRODUCT=academic pnpm run build",
    "build:complete": "cross-env ZETA_PRODUCT=complete pnpm run build",
    "build:host": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/verify-sandbox-preload.mjs",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json && node scripts/verify-sandbox-preload.mjs",
    "build:renderer": "tsc -p tsconfig.renderer.json --noEmit && vite build",
    "build:renderer:code": "cross-env ZETA_PRODUCT=code pnpm run build:renderer",
    "build:renderer:academic": "cross-env ZETA_PRODUCT=academic pnpm run build:renderer",
    "build:renderer:complete": "cross-env ZETA_PRODUCT=complete pnpm run build:renderer",
    "build:rust": "cargo build --manifest-path ../zeta-rs/Cargo.toml -p zeta-cli",
    "benchmark:alpha": "tsc -p tsconfig.test.json && node dist/test/src/zeta/editor/alpha/benchmark/pieceTreeTextBuffer.benchmark.js",
    "test:main": "pnpm run test:scripts && pnpm run test:unit",
    "test:scripts": "node --test scripts/prepare-dev-package.test.mjs scripts/sync-product-icons.test.mjs scripts/web-app-server-vite-plugin.test.mjs scripts/workbench-entry-vite-plugin.test.mjs",
    "test:unit": "node -e \"require('node:fs').rmSync('dist/test', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node test/unit/run.mjs",
    "pretest:smoke": "pnpm run build && tsc -p test/automation/tsconfig.json",
    "test:smoke": "playwright test",
    "test:smoke:debug": "playwright test --debug",
    "test:e2e": "pnpm run test:smoke",
    "test:e2e:debug": "pnpm run test:smoke:debug",
    "test:icons": "node --test scripts/sync-product-icons.test.mjs",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "dev": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/verify-sandbox-preload.mjs && concurrently -k -n renderer,main,preload,electron \"vite\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 && cross-env ZETA_RENDERER_URL=http://127.0.0.1:5173 nodemon --quiet --signal SIGTERM --watch dist/main --watch dist/preload --ext js,cjs --exec \\\"node scripts/run-electron.mjs\\\"\"",
    "dev:code": "cross-env ZETA_PRODUCT=code pnpm run dev",
    "dev:academic": "cross-env ZETA_PRODUCT=academic pnpm run dev",
    "dev:complete": "cross-env ZETA_PRODUCT=complete pnpm run dev",
    "dev:ui": "tsc -p tsconfig.main.json && tsc -p tsconfig.preload.json && node scripts/verify-sandbox-preload.mjs && concurrently -k -n renderer,main,preload,electron \"vite\" \"tsc -p tsconfig.main.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\" \"wait-on tcp:127.0.0.1:5173 && cross-env ZETA_DESKTOP_UI_ONLY=1 ZETA_RENDERER_URL=http://127.0.0.1:5173 nodemon --quiet --signal SIGTERM --watch dist/main --watch dist/preload --ext js,cjs --exec \\\"node scripts/run-electron.mjs\\\"\"",
    "dev:ui:code": "cross-env ZETA_PRODUCT=code pnpm run dev:ui",
    "dev:ui:academic": "cross-env ZETA_PRODUCT=academic pnpm run dev:ui",
    "dev:ui:complete": "cross-env ZETA_PRODUCT=complete pnpm run dev:ui",
    "dev:renderer": "vite",
    "dev:web": "vite",
    "dev:web:code": "cross-env ZETA_PRODUCT=code pnpm run dev:web",
    "dev:web:academic": "cross-env ZETA_PRODUCT=academic pnpm run dev:web",
    "dev:web:complete": "cross-env ZETA_PRODUCT=complete pnpm run dev:web",
    "dev:web:full": "cross-env ZETA_WEB_APP_SERVER=1 vite --force",
    "dev:web:full:code": "cross-env ZETA_PRODUCT=code pnpm run dev:web:full",
    "dev:web:full:academic": "cross-env ZETA_PRODUCT=academic pnpm run dev:web:full",
    "dev:web:full:complete": "cross-env ZETA_PRODUCT=complete pnpm run dev:web:full",
    "dev:main": "tsc -p tsconfig.main.json --watch --preserveWatchOutput",
    "dev:preload": "tsc -p tsconfig.preload.json --watch --preserveWatchOutput",
    "dev:electron": "wait-on tcp:127.0.0.1:5173 && cross-env ZETA_RENDERER_URL=http://127.0.0.1:5173 nodemon --quiet --signal SIGTERM --watch dist/main --watch dist/preload --ext js,cjs --exec \"node scripts/run-electron.mjs\"",
    "prestart": "node scripts/prepare-dev-package.mjs",
    "start": "node scripts/run-electron.mjs",
    "start:code": "cross-env ZETA_PRODUCT=code pnpm run start",
    "start:academic": "cross-env ZETA_PRODUCT=academic pnpm run start",
    "start:complete": "cross-env ZETA_PRODUCT=complete pnpm run start"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "jsdom": "^29.1.1",
    "nodemon": "^3.1.14",
    "svgo": "4.0.1",
    "typescript": "^5.9.0",
    "vite": "^8.1.5",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.12",
    "markdown-it": "^14.3.0",
    "marked": "^18.0.7",
    "monaco-editor": "^0.56.0",
    "prosemirror-commands": "^1.7.1",
    "prosemirror-history": "^1.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-schema-basic": "^1.2.4",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-view": "^1.42.2",
    "vscode-oniguruma": "1.7.0",
    "vscode-textmate": "9.3.2"
  }
}
