{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "types": ["vite/client"]
  },
  "include": [
    "src/base/**/*.ts",
    "src/code/browser/**/*.ts",
    "src/code/electron-browser/workbench/**/*.ts",
    "src/platform/app-server/common/**/*.ts",
    "src/platform/action/common/**/*.ts",
    "src/platform/actions/**/*.ts",
    "src/platform/commands/common/**/*.ts",
    "src/platform/configuration/common/**/*.ts",
    "src/platform/contextkey/common/**/*.ts",
    "src/platform/contextview/browser/**/*.ts",
    "src/platform/contextview/electron-browser/**/*.ts",
    "src/platform/instantiation/common/**/*.ts",
    "src/platform/keybinding/**/*.ts",
    "src/platform/keyboardLayout/**/*.ts",
    "src/platform/menubar/common/**/*.ts",
    "src/platform/native/common/**/*.ts",
    "src/platform/theme/browser/**/*.ts",
    "src/platform/theme/common/**/*.ts",
    "src/platform/workspace/common/**/*.ts",
    "src/workbench/**/*.ts",
    "generated/**/*.ts"
  ],
  "exclude": [
    "src/base/test/**/*.ts",
    "src/base/parts/**/electron-main/**/*.ts",
    "src/platform/keybinding/electron-main/**/*.ts"
  ]
}
