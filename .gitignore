# Canonical local build products
.build/

# Legacy output paths remain ignored so older tools cannot re-add them.
target/
__pycache__/
*.py[cod]

# Bazel creates these workspace-root symlinks for its output tree.
/bazel-*
/user.bazelrc

# Per-workspace runtime state
.zeta/
.playwright-*/
.temp
.tmp/
output/
!zeta-ts/src/zeta/workbench/contrib/output/
!zeta-ts/src/zeta/workbench/contrib/output/**
!zeta-ts/src/zeta/workbench/services/output/
!zeta-ts/src/zeta/workbench/services/output/**

# Legacy Desktop build products
zeta-ts/node_modules/
zeta-ts/dist/
zeta-ts/test/editor/browser/dist/
zeta-ts/.tmp/
zeta-ts/debug.log
node_modules/
.pnpm-store/
zeta-ts/generated/app-server/
zeta-ts/generated/file-icons/
zeta-ts/generated/product-icons.ts
schemas/app-server/

# Downloaded, checksum-verified third-party native runtime artifacts.
third_party/.cache/


.DS_Store
