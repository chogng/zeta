# Canonical local build products
.build/
/.tooling/

# Legacy output paths remain ignored so older tools cannot re-add them.
target/
__pycache__/
*.py[cod]

# Bazel creates these workspace-root symlinks for its output tree.
/bazel-*
/user.bazelrc

# Per-workspace runtime state
.zeta/
.playwright-*/
.temp
.tmp/
output/
!desktop/src/zeta/workbench/contrib/output/
!desktop/src/zeta/workbench/contrib/output/**
!desktop/src/zeta/workbench/services/output/
!desktop/src/zeta/workbench/services/output/**

# Legacy Desktop build products
desktop/node_modules/
desktop/dist/
desktop/test/editor/browser/dist/
desktop/.tmp/
desktop/debug.log
node_modules/
.pnpm-store/
desktop/generated/app-server/
desktop/generated/file-icons/
desktop/generated/product-icons.ts
schemas/app-server/

# Downloaded, checksum-verified third-party native runtime artifacts.
third_party/.cache/


.DS_Store
