{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zeta.dev/schemas/design-tokens.schema.json",
  "title": "Zeta design token manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "colors",
    "sizes"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "colors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/color"
      }
    },
    "sizes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/size"
      }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "cssVariable",
        "owner",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)*$"
        },
        "kind": {
          "type": "string"
        },
        "cssVariable": {
          "type": "string",
          "pattern": "^--zeta-"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "deprecated": {
          "type": "string"
        }
      }
    },
    "color": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "defaults",
            "values",
            "needsTransparency"
          ],
          "properties": {
            "kind": {
              "const": "color"
            },
            "needsTransparency": {
              "type": "boolean"
            },
            "defaults": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dark",
                "light",
                "high-contrast-dark",
                "high-contrast-light"
              ],
              "properties": {
                "dark": {
                  "$ref": "#/$defs/colorValue"
                },
                "light": {
                  "$ref": "#/$defs/colorValue"
                },
                "high-contrast-dark": {
                  "$ref": "#/$defs/colorValue"
                },
                "high-contrast-light": {
                  "$ref": "#/$defs/colorValue"
                }
              }
            },
            "values": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "dark",
                "light",
                "high-contrast-dark",
                "high-contrast-light"
              ],
              "properties": {
                "dark": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "light": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "high-contrast-dark": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "high-contrast-light": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "colorValue": {
      "anyOf": [
        {
          "type": [
            "string",
            "null"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "transparent"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "lighten"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "darken"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "other",
            "factor"
          ],
          "properties": {
            "op": {
              "const": "mix"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "other": {
              "$ref": "#/$defs/colorValue"
            },
            "factor": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "value",
            "background"
          ],
          "properties": {
            "op": {
              "const": "opaque"
            },
            "value": {
              "$ref": "#/$defs/colorValue"
            },
            "background": {
              "$ref": "#/$defs/colorValue"
            }
          }
        }
      ]
    },
    "size": {
      "allOf": [
        {
          "$ref": "#/$defs/common"
        },
        {
          "type": "object",
          "required": [
            "value"
          ],
          "properties": {
            "kind": {
              "const": "size"
            },
            "value": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
