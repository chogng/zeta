--- a/build.rs
+++ b/build.rs
@@ -735,0 +736,7 @@
+
+  // rules_rs exposes OUT_DIR as a declared tree artifact. Cargo's normal
+  // parent-directory layout is shared across build scripts and is not
+  // captured by Bazel, so opt into the declared directory only for Bazel.
+  if env::var_os("RUSTY_V8_USE_OUT_DIR").is_some() {
+    return PathBuf::from(env::var_os("OUT_DIR").expect("OUT_DIR is not set"));
+  }
