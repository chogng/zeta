{
  "formatVersion": 1,
  "artifact": "bin/app",
  "signatureRecord": "app-signature.json",
  "releaseRequired": true,
  "authenticatedResources": {
    "remoteRuntimeCatalog": "HTTPS URL when network-backed and SHA-256 compiled into the signed binary",
    "remoteRuntimeArtifacts": "SHA-256 records in the authenticated catalog"
  },
  "platforms": {
    "darwin": {
      "tool": "codesign",
      "signatureMode": "embedded",
      "identityEnvironment": "APP_MACOS_SIGNING_IDENTITY",
      "verification": ["codesign", "--verify", "--strict"]
    },
    "linux": {
      "tool": "cosign",
      "signatureMode": "detached",
      "signatureFile": "app-signature.sig",
      "identityEnvironment": "APP_COSIGN_IDENTITY",
      "verification": ["cosign", "verify-blob"]
    },
    "windows": {
      "tool": "signtool",
      "signatureMode": "embedded",
      "identityEnvironment": "APP_WINDOWS_CERTIFICATE",
      "verification": ["signtool", "verify", "/pa"]
    }
  }
}
