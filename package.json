{
  "name": "zeta",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build:desktop": "corepack pnpm --dir desktop build",
    "test:desktop:editor": "corepack pnpm --dir desktop test:editor",
    "test:desktop:app": "corepack pnpm --dir desktop test:app",
    "test:desktop:app:pdf-corpus": "corepack pnpm --dir desktop test:app:pdf-corpus",
    "test:desktop:smoke": "corepack pnpm --dir desktop test:smoke:desktop",
    "test:desktop:smoke:ui": "corepack pnpm --dir desktop test:smoke:ui",
    "test:desktop:smoke:browser": "corepack pnpm --dir desktop test:smoke:browser",
    "test:desktop:smoke:browser:full": "corepack pnpm --dir desktop test:smoke:browser:full",
    "test:desktop:e2e": "corepack pnpm test:desktop:smoke",
    "dev:desktop": "corepack pnpm --dir desktop dev",
    "dev:desktop:ui": "corepack pnpm --dir desktop dev:ui",
    "dev:desktop:rust": "corepack pnpm --dir desktop dev:rust",
    "dev:web": "corepack pnpm --dir desktop dev:web",
    "dev:web:full": "corepack pnpm --dir desktop dev:web:full",
    "fetch:pdfium": "node scripts/fetch-pdfium.mjs",
    "sync:file-icons": "node desktop/scripts/sync-file-icons.mjs",
    "package:zeta": "python3 scripts/build_zeta_package.py",
    "generate:protocol": "cargo run --quiet --manifest-path Cargo.toml -p zeta-app-server-protocol --bin write_schema_fixtures && node desktop/scripts/sync-app-server-protocol.mjs",
    "verify:file-icons": "cargo test --manifest-path Cargo.toml -p zeta-file-icons",
    "verify:protocol": "cargo test --manifest-path Cargo.toml -p zeta-app-server-protocol"
  }
}
