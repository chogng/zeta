load("//zeterm:defs.bzl", "zeterm_rust_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

package(default_visibility = ["//visibility:public"])

zeterm_rust_binary(
    name = "zeterm",
    crate_name = "zeterm",
    crate_root = "src/main.rs",
    package_name = "zeterm",
)

exports_files([
    "Cargo.toml",
])

filegroup(
    name = "zeterm_sources",
    srcs = glob([
        "src/**/*.rs",
        "Cargo.toml",
    ]) + [
        "//:Cargo.lock",
        "//:Cargo.toml",
        "//zeterm/agent-sidebar:agent-sidebar_sources",
        "//zeterm/commands:commands_sources",
        "//zeterm/composer:composer_sources",
        "//zeterm/editor:editor_sources",
        "//zeterm/icons:icons_sources",
        "//zeterm/keybinding:keybinding_sources",
        "//zeterm/layout:layout_sources",
        "//zeterm/markdown:markdown_sources",
        "//zeterm/native-keybindings:native-keybindings_sources",
        "//zeterm/renderer:renderer_sources",
        "//zeterm/settings:settings_sources",
        "//zeterm/ui:ui_sources",
        "//zeterm/wgpu:wgpu_sources",
        "//zeterm/winit:winit_sources",
        "//zeterm/zui:zui_sources",
        "//zeterm/zui-demo:zui_demo_sources",
    ],
)

filegroup(
    name = "zeterm_package_contract",
    srcs = [
        "packaging/zeterm-package-contract.json",
        "packaging/zeterm-signing-policy.json",
    ],
)

filegroup(
    name = "zeterm_package_tool",
    srcs = [
        "//build/release:build_remote_runtime_bundle.py",
        "//build/release:build_zeterm_package.py",
        "//build/release:remote_runtime_bundle.py",
    ],
)

filegroup(
    name = "zeterm_release_inputs",
    srcs = [
        ":zeterm_package_contract",
        ":zeterm_package_tool",
        ":zeterm_sources",
    ],
)

sh_test(
    name = "zeterm_boundary_test",
    srcs = ["//build/release:check_zeterm_boundary.sh"],
    args = [
        "$(location //build/release:check_zeterm_boundary.py)",
        "$(location //:Cargo.toml)",
        "$(location Cargo.toml)",
        "$(location //:Cargo.lock)",
    ],
    data = [
        "//:Cargo.lock",
        "//:Cargo.toml",
        "Cargo.toml",
        "//build/release:check_zeterm_boundary.py",
    ],
    size = "small",
)

sh_test(
    name = "zeterm_package_test",
    srcs = ["//build/release:test_zeterm_package.sh"],
    args = ["$(location //build/release:test_zeterm_package.py)"],
    data = [
        "//zeterm:zeterm_package_contract",
        "//build/release:build_zeterm_package.py",
        "//build/release:remote_runtime_bundle.py",
        "//build/release:test_remote_runtime_bundle.py",
        "//build/release:test_zeterm_package.py",
    ],
    size = "small",
)

sh_test(
    name = "remote_runtime_bundle_test",
    srcs = ["//build/release:test_remote_runtime_bundle.sh"],
    args = ["$(location //build/release:test_remote_runtime_bundle.py)"],
    data = [
        "//build/release:remote_runtime_bundle.py",
        "//build/release:test_remote_runtime_bundle.py",
    ],
    size = "small",
)

sh_test(
    name = "zeterm_release_contract_test",
    srcs = ["//build/release:check_zeterm_release_contract.sh"],
    args = [
        "$(location //build/release:check_zeterm_release_contract.py)",
        "$(location packaging/zeterm-package-contract.json)",
        "$(location packaging/zeterm-signing-policy.json)",
    ],
    data = [
        "packaging/zeterm-package-contract.json",
        "packaging/zeterm-signing-policy.json",
        "//build/release:check_zeterm_release_contract.py",
    ],
    size = "small",
)

sh_test(
    name = "zeterm_signing_test",
    srcs = ["//build/release:test_zeterm_signing.sh"],
    args = ["$(location //build/release:test_zeterm_signing.py)"],
    data = [
        "//zeterm:zeterm_package_contract",
        "//build/release:build_zeterm_package.py",
        "//build/release:remote_runtime_bundle.py",
        "//build/release:test_remote_runtime_bundle.py",
        "//build/release:test_zeterm_signing.py",
        "//build/release:zeterm_signing.py",
    ],
    size = "small",
)

test_suite(
    name = "zeterm_ci",
    tests = [
        ":remote_runtime_bundle_test",
        ":zeterm_boundary_test",
        ":zeterm_package_test",
        ":zeterm_release_contract_test",
        ":zeterm_signing_test",
    ],
)
