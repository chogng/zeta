{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zeta App Server Protocol v1",
  "type": "object",
  "definitions": {
    "threadId": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "minLength": 1 },
    "turnStatus": {
      "type": "string",
      "enum": ["created", "running", "waitingForApproval", "waitingForUserInput", "waitingForCapability", "cancelling", "completed", "failed", "interrupted"]
    },
    "theme": { "type": "string", "enum": ["light", "dark", "system"] },
    "initializeParams": {
      "type": "object",
      "required": ["clientInfo", "protocolVersions", "capabilities"],
      "properties": {
        "clientInfo": {
          "type": "object",
          "required": ["name", "version"],
          "properties": { "name": { "type": "string" }, "version": { "type": "string" } }
        },
        "protocolVersions": {
          "type": "object",
          "required": ["min", "max"],
          "properties": { "min": { "type": "integer", "minimum": 1 }, "max": { "type": "integer", "minimum": 1 } }
        },
        "capabilities": { "type": "object" }
      }
    },
    "initializeResult": {
      "type": "object",
      "required": ["serverInfo", "protocolVersion", "schemaHash", "capabilities"]
    },
    "threadStartParams": {
      "type": "object",
      "required": ["idempotencyKey", "title"],
      "properties": { "idempotencyKey": { "type": "string", "minLength": 1 }, "title": { "type": "string" } }
    },
    "threadStartResult": {
      "type": "object",
      "required": ["threadId", "sequence"],
      "properties": { "threadId": { "$ref": "#/definitions/threadId" }, "sequence": { "type": "integer", "minimum": 0 } }
    },
    "threadReadParams": {
      "type": "object",
      "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/definitions/threadId" } }
    },
    "threadResumeParams": {
      "type": "object",
      "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/definitions/threadId" } }
    },
    "threadUnsubscribeParams": {
      "type": "object",
      "required": ["threadId"],
      "properties": { "threadId": { "$ref": "#/definitions/threadId" } }
    },
    "turn": {
      "type": "object",
      "required": ["turnId", "status"],
      "properties": { "turnId": { "$ref": "#/definitions/turnId" }, "status": { "$ref": "#/definitions/turnStatus" } }
    },
    "thread": {
      "type": "object",
      "required": ["threadId", "title", "sequence", "turns"],
      "properties": {
        "threadId": { "$ref": "#/definitions/threadId" },
        "title": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 0 },
        "turns": { "type": "array", "items": { "$ref": "#/definitions/turn" } }
      }
    },
    "threadReadResult": {
      "type": "object",
      "required": ["thread"],
      "properties": { "thread": { "$ref": "#/definitions/thread" } }
    },
    "threadListResult": {
      "type": "object",
      "required": ["threads"],
      "properties": { "threads": { "type": "array", "items": { "$ref": "#/definitions/thread" } } }
    },
    "turnStartParams": {
      "type": "object",
      "required": ["idempotencyKey", "threadId", "input"],
      "properties": {
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "threadId": { "$ref": "#/definitions/threadId" },
        "input": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["type", "text"],
            "properties": { "type": { "const": "text" }, "text": { "type": "string" } }
          }
        }
      }
    },
    "turnStartResult": {
      "type": "object",
      "required": ["turnId", "sequence"],
      "properties": { "turnId": { "$ref": "#/definitions/turnId" }, "sequence": { "type": "integer", "minimum": 0 } }
    },
    "turnInterruptParams": {
      "type": "object",
      "required": ["threadId", "turnId"],
      "properties": { "threadId": { "$ref": "#/definitions/threadId" }, "turnId": { "$ref": "#/definitions/turnId" } }
    },
    "configReadResult": {
      "type": "object",
      "required": ["preferredModel", "theme"],
      "properties": {
        "preferredModel": { "type": ["string", "null"] },
        "theme": { "anyOf": [{ "$ref": "#/definitions/theme" }, { "type": "null" }] }
      }
    },
    "configUpdateParams": {
      "type": "object",
      "required": ["idempotencyKey"],
      "properties": {
        "idempotencyKey": { "type": "string", "minLength": 1 },
        "preferredModel": { "type": ["string", "null"] },
        "theme": { "anyOf": [{ "$ref": "#/definitions/theme" }, { "type": "null" }] }
      }
    },
    "resourceMetadataParams": {
      "type": "object",
      "required": ["resourceId"],
      "properties": { "resourceId": { "type": "string", "minLength": 1 } }
    },
    "resourceMetadataResult": {
      "type": "object",
      "required": ["resourceId", "mimeType", "size", "sha256"]
    },
    "resourceReadParams": {
      "type": "object",
      "required": ["resourceId", "offset", "maxBytes"],
      "properties": {
        "resourceId": { "type": "string", "minLength": 1 },
        "offset": { "type": "integer", "minimum": 0 },
        "maxBytes": { "type": "integer", "minimum": 1, "maximum": 262144 }
      }
    },
    "resourceReadResult": {
      "type": "object",
      "required": ["resourceId", "offset", "data", "eof"]
    },
    "resourceReleaseParams": {
      "type": "object",
      "required": ["resourceId"],
      "properties": { "resourceId": { "type": "string", "minLength": 1 } }
    },
    "threadStartedNotification": {
      "type": "object",
      "required": ["threadId", "sequence"]
    },
    "turnStartedNotification": {
      "type": "object",
      "required": ["threadId", "turnId", "sequence"]
    },
    "agentMessageCompletedNotification": {
      "type": "object",
      "required": ["threadId", "turnId", "text", "sequence"]
    },
    "turnCompletedNotification": {
      "type": "object",
      "required": ["threadId", "turnId", "sequence"]
    },
    "turnInterruptedNotification": {
      "type": "object",
      "required": ["threadId", "turnId", "sequence"]
    },
    "appServerError": {
      "type": "object",
      "required": ["code", "message", "data"],
      "properties": {
        "code": { "type": "integer" },
        "message": {
          "type": "string",
          "enum": ["ParseError", "InvalidRequest", "MethodNotFound", "InvalidParams", "InternalError", "ServerOverloaded", "NotInitialized", "AlreadyInitialized", "ProtocolVersionUnsupported", "IdempotencyConflict", "CoreOperationFailed", "ResourceNotFound", "ResourceNotOwner", "ResourceTooLarge", "InvalidResourceChunkSize", "InvalidResourceOffset", "ConfigUnavailable"]
        },
        "data": { "type": "null" }
      }
    }
  }
}
