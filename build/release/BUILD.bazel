package(default_visibility = ["//visibility:public"])

filegroup(
    name = "package_sources",
    srcs = glob(["package/*.py"], exclude = ["package/test_*.py"]) + [
        "__init__.py",
        "system_signing.py",
        "//build/lib/ash_build:python_sources",
    ],
)

filegroup(
    name = "remote_sources",
    srcs = glob(["remote/*.py"], exclude = ["remote/test_*.py"]) + [
        "__init__.py",
        "archive.py",
        "//build/lib/ash_build:python_sources",
    ],
)

filegroup(
    name = "app_sources",
    srcs = glob(["app/*.py"], exclude = ["app/test_*.py"]) + [
        ":package_sources",
        ":remote_sources",
    ],
)

exports_files([
    "app/check_boundary.py",
    "app/check_contract.py",
    "app/test_package.py",
    "app/test_signing.py",
    "remote/test_bundle.py",
])
